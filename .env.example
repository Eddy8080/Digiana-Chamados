# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-segura-de-50-chars-ou-mais
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Superusuário inicial (criado pelo setup_inicial no primeiro deploy) ───────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ── Banco de dados (aponta para o container "db" do docker-compose) ─────────
DATABASE_URL=postgresql://digiana_user:digiana_pass@db:5432/digiana_db

# Variáveis consumidas diretamente pelo container do PostgreSQL
POSTGRES_DB=digiana_db
POSTGRES_USER=digiana_user
POSTGRES_PASSWORD=digiana_pass

# ── URL pública (usada nos links dos e-mails) ────────────────────────────────
SITE_URL=http://localhost:8000

# ── Cloudinary (opcional — deixe em branco para usar disco local, persistido
#    pelo volume "media_volume" do docker-compose. Só é necessário em PaaS de
#    container efêmero, como Railway; não é o caso de uma VPS própria) ────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
